  "liveNow": true,
  "panels": [
    {
      "id": 1,
      "title": "Nodes Online (last 2 min)",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"mybucket\")\n  |> range(start: -2m)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"node_health\")\n  |> filter(fn: (r) => r[\"_field\"] == \"online\")\n  |> group(columns: [\"node_name\"])\n  |> last()\n  |> group()\n  |> count()",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "none",
          "displayName": "Nodes Online"
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
