# Bass Sentry Configuration
# Copy this file to .env and customize for your deployment

# =============================================================================
# InfluxDB Configuration (required for master node)
# =============================================================================
BASS_SENTRY_INFLUXDB__URL=http://influxdb:8086
BASS_SENTRY_INFLUXDB__TOKEN=your-secret-token-here-change-me
BASS_SENTRY_INFLUXDB__ORG=myorg
BASS_SENTRY_INFLUXDB__BUCKET=mybucket
BASS_SENTRY_INFLUXDB__TIMEOUT=10000

# =============================================================================
# MQTT Broker Configuration
# =============================================================================
BASS_SENTRY_MQTT__HOST=mosquitto
BASS_SENTRY_MQTT__PORT=1883
BASS_SENTRY_MQTT__KEEPALIVE=60
BASS_SENTRY_MQTT__QOS=0
BASS_SENTRY_MQTT__TOPIC_SUFFIX=remote_node

# =============================================================================
# Audio Capture Settings
# =============================================================================
# Sample rate in Hz (typically 44100 or 48000)
BASS_SENTRY_AUDIO__SAMPLE_RATE=44100

# Bit depth (8, 16, or 32)
BASS_SENTRY_AUDIO__BIT_DEPTH=16

# Duration of each audio chunk in seconds
BASS_SENTRY_AUDIO__CHUNK_DURATION=0.5

# How many chunks to send per second (1/CHUNK_DURATION)
BASS_SENTRY_AUDIO__SENDING_RATE=2

# Number of audio channels (1=mono, 2=stereo)
BASS_SENTRY_AUDIO__CHANNELS=1

# =============================================================================
# Cross-Correlation Settings (master node)
# =============================================================================
# How many seconds of audio to buffer for correlation
BASS_SENTRY_CORRELATION__BUFFER_SECONDS=2.0

# Reference SPL level for calibration (dBSPL)
BASS_SENTRY_CORRELATION__REFERENCE_DBSPL=120.0

# Maximum queue size (prevents memory exhaustion)
BASS_SENTRY_CORRELATION__MAX_QUEUE_SIZE=60

# Minimum correlation coefficient to consider valid (-1 to 1)
BASS_SENTRY_CORRELATION__MIN_CORRELATION_THRESHOLD=0.3

# Timestamp jitter tolerance as fraction of expected diff
BASS_SENTRY_CORRELATION__TIMESTAMP_TOLERANCE_PERCENT=0.1

# =============================================================================
# Remote Node Settings
# =============================================================================
# Unique identifier for this node (e.g., pi-1, pi-2, pi-3)
BASS_SENTRY_NODE_ID=pi-1

# Physical location of this node
BASS_SENTRY_LOCATION=dance-floor

# NTP server for time synchronization
BASS_SENTRY_NTP_SERVER=pool.ntp.org

# =============================================================================
# Logging Configuration
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
BASS_SENTRY_LOG_LEVEL=INFO

# Log format: json or text
BASS_SENTRY_LOG_FORMAT=json

# =============================================================================
# Health Check Settings (master node)
# =============================================================================
# Interval between health checks in seconds
BASS_SENTRY_HEALTH_CHECK_INTERVAL=60

# Seconds before marking a node as unhealthy
BASS_SENTRY_UNHEALTHY_THRESHOLD=120
