{
    "node_name": "{{ node_name | default(inventory_hostname) }}",
    "transport": {
        "type": "mqtt",
        "host": "{{ mqtt_host | default('master.local') }}",
        "port": {{ mqtt_port | default(1883) }}
    },
    "audio": {
        "sample_rate": {{ sample_rate | default(44100) }},
        "chunk_size": {{ chunk_size | default(4096) }},
        "channels": {{ channels | default(1) }}
    },
{% if calibration_offset is defined %}
    "calibration": {
        "offset_db": {{ calibration_offset }}
    },
{% endif %}
    "logging": {
        "level": "{{ log_level | default('INFO') }}"
    }
}
