# Bass Sentry - Network Configuration for Raspberry Pi
#
# This file configures WiFi for the Pi on first boot.
# Place this file on the boot partition alongside 'user-data'.
#
# IMPORTANT: Update the WiFi credentials below!

version: 2
ethernets:
  eth0:
    dhcp4: true
    optional: true

wifis:
  wlan0:
    dhcp4: true
    optional: true
    access-points:
      # Primary WiFi network
      "YOUR_WIFI_SSID":
        password: "YOUR_WIFI_PASSWORD"

      # Backup/event WiFi (optional)
      # "EVENT_WIFI_SSID":
      #   password: "EVENT_WIFI_PASSWORD"
