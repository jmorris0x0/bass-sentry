[Unit]
Description=Bass Sentry LoRa to MQTT Gateway
Documentation=https://github.com/yourusername/bass-sentry
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/bass-sentry
ExecStart=/usr/bin/python3 /home/pi/bass-sentry/gateway/lora_mqtt_gateway.py --config /home/pi/bass-sentry/config/gateway-lora-mqtt.json

# Restart on failure
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bass-sentry-gateway

# Security
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
